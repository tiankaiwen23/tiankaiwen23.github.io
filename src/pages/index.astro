---
import Base from "../layouts/Base.astro";
import PubItem from "../components/PubItem.astro";
import IconLink from "../components/IconLink.astro";
import VisitorMap from "../components/VisitorMap.astro";
import { SITE } from "../data/site";
import { NEWS } from "../data/news";
import { PUBLICATIONS } from "../data/publications";
import { EXPERIENCE } from "../data/experience";

const publications = [...PUBLICATIONS].sort((a, b) => b.year - a.year);
const recentNews = NEWS.slice(0, 3);
---

<Base>
  <!-- intro -->
  <section class="intro">
    <div class="avatar-stack" title="Hover for pixel mode">
      <img
        class="intro-avatar"
        src="/avatar.png"
        alt="Kaiwen Tian"
        width="76"
        height="76"
      />
      <img
        class="intro-avatar avatar-pixel"
        src="/avatar-pixel.png"
        alt=""
        width="76"
        height="76"
        aria-hidden="true"
      />
    </div>
    <div>
      {SITE.intro.map((p) => <p set:html={p} />)}
      <div class="intro-links">
        {SITE.links.map((l) => (
          <IconLink href={l.url} label={l.label} icon={l.icon} />
        ))}
      </div>
    </div>
  </section>

  <!-- news -->
  <section class="section">
    <h2 class="section-title">News</h2>
    <ul class="news-list">
      {
        recentNews.map((n) => (
          <li>
            <span class="news-date">{n.date}</span>
            <span set:html={n.text} />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- publications -->
  {publications.length > 0 && (
    <section class="section home-publication">
      <h2 class="section-title">Publications</h2>
      {publications.map((pub) => <PubItem pub={pub} />)}
    </section>
  )}

  <!-- education -->
  <section class="section education-section" aria-labelledby="education-title">
    <h2 class="section-title" id="education-title">Education</h2>
    <div class="education-item experience-item">
      <div class="experience-logo-wrap">
        <img class="experience-logo" src="/brands/tsinghua.png" alt="Tsinghua University logo" width="76" height="76" loading="lazy" />
      </div>
      <div class="experience-copy">
        <div class="experience-head">
          <div>
            <h3 class="experience-company">Tsinghua University</h3>
            <div class="experience-role">B.Eng. in Automation</div>
          </div>
          <span class="experience-period">Sep 2023 — Jun 2027 (expected)</span>
        </div>
        <p>GPA <strong>3.9/4.0</strong> · Rank <strong>8/173</strong> (top 5%)</p>
      </div>
    </div>
  </section>

  <!-- experience -->
  <section class="section experience-section">
    <h2 class="section-title">Experience</h2>
    <div class="experience-list">
      {EXPERIENCE.map((item) => (
        <div class="experience-item">
          <div class:list={["experience-logo-wrap", { "experience-logo-dark": item.logoTheme === "dark" }]}>
            <img class="experience-logo" src={item.logo} alt={`${item.company} logo`} width="80" height="48" loading="lazy" />
          </div>
          <div class="experience-copy">
            <div class="experience-head">
              <div>
                {item.url ? <a class="experience-company" href={item.url} target="_blank" rel="noreferrer">{item.company}</a> : <span class="experience-company">{item.company}</span>}
                <div class="experience-role">{item.role}</div>
              </div>
              <span class="experience-period">
                {item.period.replace(/ — now$/, " — ")}
                {item.period.endsWith("now") && <span class="now">now</span>}
              </span>
            </div>
            <p>{item.focus}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- misc -->
  <section class="section misc-section">
    <h2 class="section-title">Misc</h2>
    {SITE.misc.map((line) => <p set:html={line} />)}
  </section>

  <!-- visitor map (dev: sample dots; prod: needs SITE.visitorApi) -->
  <VisitorMap />

</Base>
