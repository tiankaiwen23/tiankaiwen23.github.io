---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const categories = ["Thoughts", "Travel", "Notes"] as const;
const grouped = categories
  .map((cat) => ({
    cat,
    items: posts.filter((p) => p.data.category === cat),
  }))
  .filter((g) => g.items.length > 0);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", day: "2-digit" });
---

<Base
  title="Blog"
  description="A note on building this homepage by Kaiwen Tian."
>
  <div class="page-head">
    <h1>Blog</h1>
    <p class="page-sub">
      A note on building this site.
    </p>
  </div>

  {
    grouped.map((g) => (
      <section class="section">
        <h2 class="section-title">{g.cat}</h2>
        <ul class="writing-list">
          {g.items.map((post) => (
            <li>
              <span class="writing-date">{fmt(post.data.date)}</span>
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
